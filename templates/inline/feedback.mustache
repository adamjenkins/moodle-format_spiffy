{{!
    @template format_spiffy/inline/feedback

    A one-question feedback answered on its card. Exactly one of isradio, ischeckbox, isselect,
    isnumeric, istextfield and istextarea is set. Also included by feedback_done to answer again.

    Example context (json):
    {
        "cmid": 7,
        "itemid": 12,
        "fieldid": "spiffy-feedback-7-12",
        "name": "How useful was this week?",
        "required": true,
        "labels": ["<p>Tell us honestly.</p>"],
        "isradio": true,
        "ischoice": true,
        "options": [
            {"value": 1, "text": "Very useful", "id": "spiffy-feedback-7-12-1"},
            {"value": 2, "text": "Not much", "id": "spiffy-feedback-7-12-2"}
        ],
        "rangehint": "",
        "maxlength": 255,
        "rows": 4
    }
}}
<form class="spiffy-inline spiffy-feedback" data-spiffy-action="submit" data-cmid="{{cmid}}">
    {{#labels}}
        <div class="spiffy-feedback-label">{{{.}}}</div>
    {{/labels}}
    {{#ischoice}}
        <fieldset class="spiffy-feedback-field" aria-labelledby="{{fieldid}}-question">
            <div class="spiffy-feedback-question" id="{{fieldid}}-question">{{{name}}}{{#required}} <span class="spiffy-feedback-required" aria-hidden="true">*</span><span class="visually-hidden">{{#str}} required {{/str}}</span>{{/required}}</div>
            {{#isradio}}
                {{#options}}
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="value" value="{{value}}" id="{{id}}"{{#required}} required{{/required}}>
                        <label class="form-check-label" for="{{id}}">{{{text}}}</label>
                    </div>
                {{/options}}
            {{/isradio}}
            {{#ischeckbox}}
                {{#options}}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="value[]" value="{{value}}" id="{{id}}">
                        <label class="form-check-label" for="{{id}}">{{{text}}}</label>
                    </div>
                {{/options}}
            {{/ischeckbox}}
        </fieldset>
    {{/ischoice}}
    {{^ischoice}}
        <div class="spiffy-feedback-field">
            <label class="spiffy-feedback-question form-label" for="{{fieldid}}">{{{name}}}{{#required}} <span class="spiffy-feedback-required" aria-hidden="true">*</span><span class="visually-hidden">{{#str}} required {{/str}}</span>{{/required}}</label>
            {{#isselect}}
                <select class="form-select" name="value" id="{{fieldid}}"{{#required}} required{{/required}}>
                    <option value="">{{#str}} choosedots {{/str}}</option>
                    {{#options}}
                        <option value="{{value}}">{{{text}}}</option>
                    {{/options}}
                </select>
            {{/isselect}}
            {{#isnumeric}}
                <input class="form-control spiffy-feedback-number" type="text" inputmode="decimal" name="value" id="{{fieldid}}"{{#rangehint}} aria-describedby="{{fieldid}}-hint"{{/rangehint}}{{#required}} required{{/required}}>
                {{#rangehint}}
                    <div class="form-text" id="{{fieldid}}-hint">{{rangehint}}</div>
                {{/rangehint}}
            {{/isnumeric}}
            {{#istextfield}}
                <input class="form-control" type="text" name="value" id="{{fieldid}}" maxlength="{{maxlength}}"{{#required}} required{{/required}}>
            {{/istextfield}}
            {{#istextarea}}
                <textarea class="form-control" name="value" id="{{fieldid}}" rows="{{rows}}"{{#required}} required{{/required}}></textarea>
            {{/istextarea}}
        </div>
    {{/ischoice}}
    <button type="submit" class="btn mds-btn btn-primary mt-2">{{#str}} submit {{/str}}</button>
</form>
