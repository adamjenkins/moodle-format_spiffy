{{!
    @template format_spiffy/inline/forum_post

    One forum post on a card: the author, the time and the message.

    Example context (json):
    {
        "id": 12,
        "author": "Sam Student",
        "picture": "",
        "time": "2/11/26, 10:15",
        "isotime": "2026-11-02T10:15:00+00:00",
        "subject": "Re: Introduce yourself",
        "showsubject": false,
        "message": "<p>Hello, I am Sam.</p>",
        "private": false
    }
}}
<article class="spiffy-forum-post" aria-labelledby="spiffy-forum-post-{{id}}-author">
    <header class="spiffy-forum-meta">
        {{{picture}}}
        <span class="spiffy-forum-author" id="spiffy-forum-post-{{id}}-author">{{author}}</span>
        <time class="spiffy-forum-time" datetime="{{isotime}}">{{time}}</time>
        {{#private}}
            <span class="badge mds-badge text-bg-secondary">{{#str}} forum_privatereply, format_spiffy {{/str}}</span>
        {{/private}}
    </header>
    {{#showsubject}}
        <p class="spiffy-forum-subject">{{{subject}}}</p>
    {{/showsubject}}
    <div class="spiffy-forum-message">{{{message}}}</div>
</article>
