{{!
    @template format_spiffy/inline/resource

    A file shown inside its card: a PDF preview (with a download link where the browser cannot
    show PDFs) or the image itself, and always a download link.

    Example context (json):
    {
        "cmid": 9,
        "name": "Reading list",
        "ispdf": true,
        "isimage": false,
        "url": "https://example.com/pluginfile.php/30/mod_resource/content/1/list.pdf",
        "downloadurl": "https://example.com/pluginfile.php/30/mod_resource/content/1/list.pdf?forcedownload=1",
        "downloadlabel": "Download list.pdf",
        "size": "120.5 KB",
        "canmark": true,
        "markread": false,
        "done": false
    }
}}
<div class="spiffy-inline spiffy-resource{{#done}} spiffy-done-view{{/done}}">
    {{#ispdf}}
        <div class="spiffy-resource-pdf">
            <object data="{{url}}" type="application/pdf" title="{{name}}" aria-label="{{name}}">
                <p class="spiffy-resource-fallback">{{#str}} pdfnopreview, format_spiffy {{/str}}</p>
            </object>
        </div>
    {{/ispdf}}
    {{#isimage}}
        <img class="spiffy-resource-image img-fluid" src="{{url}}" alt="{{name}}" loading="lazy">
    {{/isimage}}
    <p class="spiffy-resource-links">
        <a href="{{downloadurl}}" class="spiffy-resource-download">{{downloadlabel}}</a>
        <span class="spiffy-resource-size text-muted">({{size}})</span>
    </p>
    {{> format_spiffy/inline/page_markread }}
</div>
