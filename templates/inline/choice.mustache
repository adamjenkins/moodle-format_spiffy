{{!
    @template format_spiffy/inline/choice

    A choice answered on its card: one click per option, or tick and save when several answers
    are allowed.

    Example context (json):
    {
        "cmid": 5,
        "name": "Which day suits you?",
        "multiple": false,
        "options": [
            {"id": 1, "text": "Monday", "disabled": false, "checked": false},
            {"id": 2, "text": "Tuesday", "disabled": true, "checked": false}
        ]
    }
}}
<form class="spiffy-inline spiffy-choice" data-spiffy-action="choose" data-cmid="{{cmid}}">
    <fieldset>
        <legend class="visually-hidden">{{name}}</legend>
        {{^multiple}}
            <div class="spiffy-choice-options">
                {{#options}}
                    <button type="submit" name="option" value="{{id}}" class="btn mds-btn btn-outline-primary spiffy-choice-option"{{#disabled}} disabled{{/disabled}}>{{{text}}}</button>
                {{/options}}
            </div>
        {{/multiple}}
        {{#multiple}}
            {{#options}}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="option[]" value="{{id}}" id="spiffy-choice-{{cmid}}-{{id}}"{{#checked}} checked{{/checked}}{{#disabled}} disabled{{/disabled}}>
                    <label class="form-check-label" for="spiffy-choice-{{cmid}}-{{id}}">{{{text}}}</label>
                </div>
            {{/options}}
            <button type="submit" class="btn mds-btn btn-primary mt-2">{{#str}} savemychoice, choice {{/str}}</button>
        {{/multiple}}
    </fieldset>
</form>
