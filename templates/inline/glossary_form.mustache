{{!
    @template format_spiffy/inline/glossary_form

    The quick "add a term" form of a Glossary card.

    Example context (json):
    {
        "cmid": 9,
        "needsapproval": true,
        "maxconcept": 255,
        "maxlength": 10000
    }
}}
<form class="spiffy-glossary-form" data-spiffy-action="add" data-cmid="{{cmid}}">
    <div class="mb-2">
        <label class="form-label" for="spiffy-glossary-concept-{{cmid}}">{{#str}} glossary_term, format_spiffy {{/str}}</label>
        <input type="text" class="form-control" id="spiffy-glossary-concept-{{cmid}}" name="concept" maxlength="{{maxconcept}}" required>
    </div>
    <div class="mb-2">
        <label class="form-label" for="spiffy-glossary-definition-{{cmid}}">{{#str}} glossary_definition, format_spiffy {{/str}}</label>
        <textarea class="form-control" id="spiffy-glossary-definition-{{cmid}}" name="definition" rows="3" maxlength="{{maxlength}}" required{{#needsapproval}} aria-describedby="spiffy-glossary-hint-{{cmid}}"{{/needsapproval}}></textarea>
        {{#needsapproval}}
            <p class="form-text" id="spiffy-glossary-hint-{{cmid}}">{{#str}} glossary_approvalhint, format_spiffy {{/str}}</p>
        {{/needsapproval}}
    </div>
    <button type="submit" class="btn mds-btn btn-primary">{{#str}} glossary_addterm, format_spiffy {{/str}}</button>
</form>
