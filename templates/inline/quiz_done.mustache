{{!
    @template format_spiffy/inline/quiz_done

    A one-question quiz the user has answered: what the quiz's review options show now (the answer,
    whether it was right, the grade, feedback, the right answer), and the form again while attempts
    remain.

    Example context (json):
    {
        "cmid": 9,
        "hasresult": true,
        "pending": false,
        "response": "Venus",
        "state": "Incorrect",
        "stateclass": "incorrect",
        "badgetype": "danger",
        "grade": "Grade: 0.00/10.00",
        "hasfeedback": true,
        "specificfeedback": "<p>Venus is second.</p>",
        "generalfeedback": "",
        "overallfeedback": "",
        "rightanswer": "Right answer: Mercury",
        "again": null
    }
}}
<div class="spiffy-inline spiffy-done-view spiffy-quiz-done">
    {{#pending}}
        <p class="spiffy-quiz-pending">{{#str}} quizpending, format_spiffy {{/str}}</p>
    {{/pending}}
    {{#hasresult}}
        <div class="spiffy-quiz-result d-flex flex-wrap align-items-center gap-2">
            {{#state}}
                <span class="badge mds-badge text-bg-{{badgetype}} spiffy-quiz-state is-{{stateclass}}">{{state}}</span>
            {{/state}}
            {{#grade}}
                <span class="spiffy-quiz-grade">{{grade}}</span>
            {{/grade}}
        </div>
        {{#response}}
            <p class="spiffy-done-answer">{{#str}} youranswer, format_spiffy {{/str}} <strong>{{response}}</strong></p>
        {{/response}}
        {{#hasfeedback}}
            <div class="spiffy-quiz-feedback">
                {{#specificfeedback}}<div class="spiffy-quiz-specificfeedback">{{{specificfeedback}}}</div>{{/specificfeedback}}
                {{#generalfeedback}}<div class="spiffy-quiz-generalfeedback">{{{generalfeedback}}}</div>{{/generalfeedback}}
                {{#overallfeedback}}<div class="spiffy-quiz-overallfeedback">{{{overallfeedback}}}</div>{{/overallfeedback}}
            </div>
        {{/hasfeedback}}
        {{#rightanswer}}
            <p class="spiffy-quiz-rightanswer">{{rightanswer}}</p>
        {{/rightanswer}}
    {{/hasresult}}
    {{#again}}
        <details class="spiffy-inline-again">
            <summary class="btn mds-btn btn-outline-primary">{{#str}} quiztryagain, format_spiffy {{/str}}</summary>
            {{> format_spiffy/inline/quiz }}
        </details>
    {{/again}}
</div>
