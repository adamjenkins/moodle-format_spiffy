{{!
    @template format_spiffy/inline/lesson_feedback

    The lesson's response to the answer just given, shown above the next page of the card.

    Example context (json):
    {
        "correct": false,
        "verdict": "Not quite.",
        "response": "<p>That's the wrong answer</p>",
        "attemptsremaining": "You have 1 attempt(s) remaining"
    }
}}
<div class="spiffy-lesson-feedback alert {{#correct}}alert-success{{/correct}}{{^correct}}alert-warning{{/correct}} py-2 mb-2" role="status">
    <p class="fw-semibold mb-1">{{verdict}}</p>
    {{{response}}}
    {{#attemptsremaining}}
        <p class="small mb-0">{{attemptsremaining}}</p>
    {{/attemptsremaining}}
</div>
