{{!
    @template format_spiffy/inline/glossary_peer

    A classmate's Glossary or Database entry on a card, with its peer reactions. A glossary entry
    has a title (the concept) and a body (the definition); a database entry has a list of fields.

    Example context (json):
    {
        "cmid": 9,
        "id": 31,
        "author": "Ana Peer",
        "picture": "",
        "time": "2/11/26, 10:00",
        "isotime": "2026-11-02T10:00:00+00:00",
        "title": "Photosynthesis",
        "body": "<p>How plants turn light into sugar.</p>",
        "hasfields": false,
        "fields": [],
        "url": "https://example.com/mod/glossary/showentry.php?eid=31",
        "rating": false,
        "comments": false
    }
}}
<article class="spiffy-peer-entry" aria-labelledby="spiffy-peer-{{cmid}}-{{id}}">
    <header class="spiffy-peer-meta">
        {{{picture}}}
        {{#author}}<span class="spiffy-peer-author" id="spiffy-peer-{{cmid}}-{{id}}">{{author}}</span>{{/author}}
        <time class="spiffy-peer-time" datetime="{{isotime}}">{{time}}</time>
    </header>
    {{#title}}
        <p class="spiffy-peer-title">{{{title}}}</p>
    {{/title}}
    {{#body}}
        <div class="spiffy-peer-body">{{{body}}}</div>
    {{/body}}
    {{#hasfields}}
        <dl class="spiffy-entry-fields">
            {{#fields}}
                <dt>{{{name}}}</dt>
                <dd>{{{value}}}</dd>
            {{/fields}}
        </dl>
    {{/hasfields}}
    {{> format_spiffy/inline/glossary_reactions }}
</article>
