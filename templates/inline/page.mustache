{{!
    @template format_spiffy/inline/page

    A short page read inside its card. Text longer than a few lines is collapsed behind a "Read
    more" expander (a native details element, so it works by keyboard without JavaScript).

    Example context (json):
    {
        "cmid": 5,
        "name": "What happens next",
        "content": "<div class=\"no-overflow\"><p>Next week we meet in room 4.</p></div>",
        "excerpt": "Next week we meet in room 4.",
        "collapsible": true,
        "canmark": true,
        "markread": true,
        "done": false
    }
}}
<div class="spiffy-inline spiffy-page{{#done}} spiffy-done-view{{/done}}">
    {{#collapsible}}
        <details class="spiffy-readmore">
            <summary class="spiffy-readmore-summary">
                <span class="spiffy-readmore-excerpt">{{excerpt}}</span>
                <span class="spiffy-readmore-more">{{#done}}{{#str}} readagain, format_spiffy {{/str}}{{/done}}{{^done}}{{#str}} readmore, format_spiffy {{/str}}{{/done}}<span class="visually-hidden">: {{{name}}}</span></span>
                <span class="spiffy-readmore-less">{{#str}} showless, format_spiffy {{/str}}<span class="visually-hidden">: {{{name}}}</span></span>
            </summary>
            <div class="spiffy-readmore-content">{{{content}}}</div>
            {{> format_spiffy/inline/page_markread }}
        </details>
    {{/collapsible}}
    {{^collapsible}}
        <div class="spiffy-readmore-content">{{{content}}}</div>
        {{> format_spiffy/inline/page_markread }}
    {{/collapsible}}
</div>
