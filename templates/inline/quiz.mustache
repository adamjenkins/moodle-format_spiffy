{{!
    @template format_spiffy/inline/quiz

    A one-question quiz answered on its card: the question and its answer field. Submitting starts,
    submits and finishes an attempt in one go. Exactly one of ismultichoice, istruefalse,
    isshortanswer and isnumerical is set. Also included by quiz_done to try again.

    Example context (json):
    {
        "cmid": 9,
        "fieldid": "spiffy-quiz-9",
        "name": "Quick check",
        "questiontext": "<p>Which planet is closest to the Sun?</p>",
        "ismultichoice": true,
        "ischoice": true,
        "options": [
            {"value": 31, "id": "spiffy-quiz-9-31", "text": "Mercury"},
            {"value": 32, "id": "spiffy-quiz-9-32", "text": "Venus"}
        ],
        "attemptsleft": "2 attempts left"
    }
}}
<form class="spiffy-inline spiffy-quiz" data-spiffy-action="answer" data-cmid="{{cmid}}">
    {{#ischoice}}
        <fieldset class="spiffy-quiz-field" aria-labelledby="{{fieldid}}-question">
            <div class="spiffy-quiz-question" id="{{fieldid}}-question">{{{questiontext}}}</div>
            {{#options}}
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="answer" value="{{value}}" id="{{id}}" required>
                    <label class="form-check-label" for="{{id}}">{{{text}}}</label>
                </div>
            {{/options}}
        </fieldset>
    {{/ischoice}}
    {{^ischoice}}
        <div class="spiffy-quiz-field">
            <div class="spiffy-quiz-question" id="{{fieldid}}-question">{{{questiontext}}}</div>
            <label class="form-label" for="{{fieldid}}">{{#str}} quizanswerlabel, format_spiffy {{/str}}</label>
            <input class="form-control spiffy-quiz-answer" type="text" name="answer" id="{{fieldid}}" maxlength="255" autocomplete="off" aria-describedby="{{fieldid}}-question" required{{#isnumerical}} inputmode="decimal"{{/isnumerical}}>
        </div>
    {{/ischoice}}
    <div class="spiffy-quiz-actions d-flex flex-wrap align-items-center gap-2 mt-2">
        <button type="submit" class="btn mds-btn btn-primary">{{#str}} quizsubmitanswer, format_spiffy {{/str}}</button>
        {{#attemptsleft}}
            <span class="spiffy-quiz-attemptsleft small text-body-secondary">{{attemptsleft}}</span>
        {{/attemptsleft}}
    </div>
</form>
