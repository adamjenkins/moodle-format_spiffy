{{!
    @template format_spiffy/inline/book

    A short book read inside its card: the chapter list, then the chapters behind a "Read more"
    expander that starts with the first chapter.

    Example context (json):
    {
        "cmid": 7,
        "name": "Lab safety",
        "showtoc": true,
        "excerpt": "Always wear goggles in the lab.",
        "chapters": [
            {"id": 1, "title": "Goggles", "sub": false, "content": "<div class=\"no-overflow\"><p>Always wear goggles in the lab.</p></div>"},
            {"id": 2, "title": "Spills", "sub": true, "content": "<div class=\"no-overflow\"><p>Tell the teacher at once.</p></div>"}
        ],
        "canmark": true,
        "markread": true,
        "done": false
    }
}}
<div class="spiffy-inline spiffy-book{{#done}} spiffy-done-view{{/done}}">
    {{#showtoc}}
        <ol class="spiffy-book-toc" aria-label="{{#str}} toc, mod_book {{/str}}">
            {{#chapters}}
                <li class="spiffy-book-toc-item{{#sub}} is-sub{{/sub}}">{{{title}}}</li>
            {{/chapters}}
        </ol>
    {{/showtoc}}
    <details class="spiffy-readmore">
        <summary class="spiffy-readmore-summary">
            <span class="spiffy-readmore-excerpt">{{excerpt}}</span>
            <span class="spiffy-readmore-more">{{#done}}{{#str}} readagain, format_spiffy {{/str}}{{/done}}{{^done}}{{#str}} readmore, format_spiffy {{/str}}{{/done}}<span class="visually-hidden">: {{{name}}}</span></span>
            <span class="spiffy-readmore-less">{{#str}} showless, format_spiffy {{/str}}<span class="visually-hidden">: {{{name}}}</span></span>
        </summary>
        <div class="spiffy-readmore-content">
            {{#chapters}}
                <section class="spiffy-book-chapter{{#sub}} is-sub{{/sub}}" aria-labelledby="spiffy-book-{{cmid}}-{{id}}">
                    <h4 class="spiffy-book-chapter-title" id="spiffy-book-{{cmid}}-{{id}}">{{{title}}}</h4>
                    {{{content}}}
                </section>
            {{/chapters}}
        </div>
        {{> format_spiffy/inline/page_markread }}
    </details>
</div>
