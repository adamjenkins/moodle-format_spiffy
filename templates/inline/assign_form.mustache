{{!
    @template format_spiffy/inline/assign_form

    The online text answer of an assignment, written on its card: a plain text box, the
    submission statement when the assignment needs one, and Save draft and Submit buttons when
    students must click Submit (otherwise one Submit button that saves and submits).

    Example context (json):
    {
        "cmid": 7,
        "name": "Short reflection",
        "text": "My first thoughts are…",
        "drafts": true,
        "draftnotice": "Draft saved 2/11/26, 14:05. It is not submitted yet.",
        "haswordlimit": true,
        "wordlimit": 150,
        "hasstatement": true,
        "statement": "This is my own work.",
        "statementrequired": false
    }
}}
<form class="spiffy-inline spiffy-assign" data-spiffy-action="save" data-cmid="{{cmid}}">
    {{#draftnotice}}
        <p class="spiffy-assign-status small mb-2">{{draftnotice}}</p>
    {{/draftnotice}}
    <label class="form-label" for="spiffy-assign-{{cmid}}-text">{{#str}} assignyouranswer, format_spiffy {{/str}}</label>
    <textarea class="form-control spiffy-assign-text" id="spiffy-assign-{{cmid}}-text" name="text" rows="5" required{{#haswordlimit}} aria-describedby="spiffy-assign-{{cmid}}-limit"{{/haswordlimit}}>{{text}}</textarea>
    {{#haswordlimit}}
        <p class="form-text mb-0" id="spiffy-assign-{{cmid}}-limit">{{#str}} assignwordlimit, format_spiffy, {{wordlimit}} {{/str}}</p>
    {{/haswordlimit}}
    {{#hasstatement}}
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="statement" value="1" id="spiffy-assign-{{cmid}}-statement"{{#statementrequired}} required{{/statementrequired}}>
            <label class="form-check-label" for="spiffy-assign-{{cmid}}-statement">{{{statement}}}</label>
        </div>
    {{/hasstatement}}
    <div class="spiffy-assign-buttons d-flex flex-wrap gap-2 mt-2">
        {{#drafts}}
            <button type="submit" class="btn mds-btn btn-outline-primary">{{#str}} assignsavedraft, format_spiffy {{/str}}</button>
            <button type="submit" name="submit" value="1" class="btn mds-btn btn-primary">{{#str}} submitassignment, mod_assign {{/str}}</button>
        {{/drafts}}
        {{^drafts}}
            <button type="submit" class="btn mds-btn btn-primary">{{#str}} submit {{/str}}</button>
        {{/drafts}}
    </div>
</form>
