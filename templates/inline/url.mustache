{{!
    @template format_spiffy/inline/url

    A YouTube video played inside its card, from youtube-nocookie.com, in a 16:9 frame.

    Example context (json):
    {
        "cmid": 11,
        "name": "Welcome video",
        "embedurl": "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
        "canmark": true,
        "markread": false,
        "done": false
    }
}}
<div class="spiffy-inline spiffy-url{{#done}} spiffy-done-view{{/done}}">
    <div class="spiffy-video ratio ratio-16x9">
        <iframe src="{{embedurl}}" title="{{name}}" loading="lazy" allow="accelerometer; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
    {{> format_spiffy/inline/page_markread }}
</div>
