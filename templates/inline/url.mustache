{{!
    @template format_spiffy/inline/url

    A YouTube video played inside its card, from youtube-nocookie.com, in a 16:9 frame. The card shows
    a play button, and the player is only loaded when it is clicked (format_spiffy/inline), so a slow
    YouTube never holds up the course page and nothing is fetched from YouTube until then.

    Example context (json):
    {
        "cmid": 11,
        "name": "Welcome video",
        "embedurl": "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
        "canmark": true,
        "markread": false,
        "done": false
    }
}}
<div class="spiffy-inline spiffy-url{{#done}} spiffy-done-view{{/done}}">
    <div class="spiffy-video ratio ratio-16x9">
        <button type="button" class="spiffy-video-play" data-spiffy-embed="{{embedurl}}" data-spiffy-title="{{name}}"
            aria-label="{{#str}} playvideoname, format_spiffy, {{name}} {{/str}}">
            <span class="spiffy-video-play-icon" aria-hidden="true">{{#pix}} t/play, core {{/pix}}</span>
            <span class="spiffy-video-play-text">{{#str}} playvideo, format_spiffy {{/str}}</span>
            <span class="spiffy-video-play-name">{{name}}</span>
        </button>
    </div>
    {{> format_spiffy/inline/page_markread }}
</div>
