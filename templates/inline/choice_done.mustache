{{!
    @template format_spiffy/inline/choice_done

    A choice the user has answered: their answer, the results when the choice shows them, and a
    way to change the answer when the choice allows it.

    Example context (json):
    {
        "cmid": 5,
        "hasanswers": true,
        "answers": ["Monday"],
        "showresults": true,
        "options": [
            {"id": 1, "text": "Monday", "mine": true, "count": 3, "percent": 75},
            {"id": 2, "text": "Tuesday", "mine": false, "count": 1, "percent": 25}
        ],
        "canchange": true
    }
}}
<div class="spiffy-inline spiffy-done-view spiffy-choice-done">
    {{#hasanswers}}
        <p class="spiffy-done-answer">{{#str}} youranswer, format_spiffy {{/str}} <strong>{{#answers}}{{{.}}} {{/answers}}</strong></p>
    {{/hasanswers}}
    {{#showresults}}
        <ul class="spiffy-results" aria-label="{{#str}} results, format_spiffy {{/str}}">
            {{#options}}
                <li class="spiffy-result{{#mine}} is-mine{{/mine}}">
                    <span class="spiffy-result-label">{{{text}}}</span>
                    <span class="spiffy-result-bar" aria-hidden="true"><span style="width: {{percent}}%"></span></span>
                    <span class="spiffy-result-count">{{#str}} votes, format_spiffy, {"count": {{count}}, "percent": {{percent}} } {{/str}}</span>
                </li>
            {{/options}}
        </ul>
    {{/showresults}}
    {{#canchange}}
        <button type="button" class="btn mds-btn btn-outline-primary spiffy-inline-undo" data-spiffy-action="remove" data-cmid="{{cmid}}">{{#str}} changeanswer, format_spiffy {{/str}}</button>
    {{/canchange}}
</div>
