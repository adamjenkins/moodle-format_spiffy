{{!
    @template format_spiffy/inline/page_markread

    The button at the end of inline content that records the view, so an activity that completes
    when viewed is done. Shown only when the activity completes on view and is not done yet.

    Example context (json):
    {
        "cmid": 5,
        "canmark": true,
        "markread": true
    }
}}
{{#canmark}}
    <div class="spiffy-markread">
        <button type="button" class="btn mds-btn btn-primary spiffy-markread-button" data-spiffy-action="view" data-cmid="{{cmid}}">
            {{#markread}}{{#str}} markasread, format_spiffy {{/str}}{{/markread}}{{^markread}}{{#str}} markasviewed, format_spiffy {{/str}}{{/markread}}
        </button>
    </div>
{{/canmark}}
