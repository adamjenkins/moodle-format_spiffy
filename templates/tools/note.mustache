{{!
    @template format_spiffy/tools/note

    The student's private note on a card: a sticky note with a padlock and "Only you can see this".
    Sent by format_spiffy/tools to format_spiffy_save_note.

    Example context (json):
    {
        "cmid": 3,
        "activityname": "Learn how to communicate here",
        "note": "Ask about the second question.",
        "notemaxlength": 10000
    }
}}
<form class="spiffy-sticky" data-spiffy-tool="note" data-cmid="{{cmid}}">
    <p class="spiffy-sticky-private" id="spiffy-note-private-{{cmid}}">
        {{#pix}} i/lock, core {{/pix}}<span>{{#str}} noteprivate, format_spiffy {{/str}}</span>
    </p>
    <label class="visually-hidden" for="spiffy-note-{{cmid}}">{{#str}} notelabel, format_spiffy, {{spiffyplainname}} {{/str}}</label>
    <textarea class="form-control spiffy-sticky-text" id="spiffy-note-{{cmid}}" name="note" rows="3"
        maxlength="{{notemaxlength}}" aria-describedby="spiffy-note-private-{{cmid}}">{{note}}</textarea>
    <div class="spiffy-tool-actions">
        <button type="submit" class="btn mds-btn mds-btn--size-sm spiffy-sticky-save">
            {{#pix}} i/marker, core {{/pix}}<span>{{#str}} savenote, format_spiffy {{/str}}</span>
        </button>
        <span class="spiffy-tool-status" data-region="spiffy-tool-status" role="status" aria-live="polite"></span>
    </div>
</form>
