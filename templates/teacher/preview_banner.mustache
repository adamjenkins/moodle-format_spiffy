{{!
    @template format_spiffy/teacher/preview_banner

    Shown at the top of the page while a teacher previews the course as a student (core's switch
    role), with the way back to their normal role. Part of format_spiffy/local/teacher_spotlight.

    Example context (json):
    {
        "isswitched": true,
        "rolename": "Student",
        "returnurl": "#"
    }
}}
<div class="spiffy-teacher-previewbar" role="status">
    {{#pix}} t/preview, core {{/pix}}
    <span>{{#str}} teacherpreviewing, format_spiffy, {{rolename}} {{/str}}</span>
    <a href="{{returnurl}}" class="btn mds-btn mds-btn--size-sm btn-primary">{{#str}} switchrolereturn, core {{/str}}</a>
</div>
