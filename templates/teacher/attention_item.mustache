{{!
    @template format_spiffy/teacher/attention_item

    The inside of one line of the teacher spotlight (the list item is in
    format_spiffy/local/teacher_spotlight): what needs attention on one card. The name focuses the card
    (format_spiffy/teacher sends format_spiffy:focuscard; the hash works without JavaScript); the
    action, when there is one, opens the grading or approval page.

    Example context (json):
    {
        "cmid": 3,
        "name": "Hand in your plan",
        "focusurl": "#module-3",
        "kind": "grading",
        "label": "3 to grade",
        "actionurl": "#",
        "actionlabel": "Grade",
        "hasaction": true
    }
}}
    <span class="badge mds-badge spiffy-teacher-badge spiffy-teacher-badge--{{kind}}">{{label}}</span>
    <a href="{{focusurl}}" class="spiffy-teacher-item-name" data-spiffy-focus="{{cmid}}">{{name}}</a>
    {{#hasaction}}
        <a href="{{actionurl}}" class="btn mds-btn mds-btn--size-sm btn-outline-primary spiffy-teacher-item-action">
            {{actionlabel}}<span class="visually-hidden">: {{name}}</span>
        </a>
    {{/hasaction}}
