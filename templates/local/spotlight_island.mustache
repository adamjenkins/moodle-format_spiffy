{{!
    @template format_spiffy/local/spotlight_island

    A subsection (mod_subsection) as a smaller island nested in its section: its name, summary,
    restrictions and progress ring, then its own cards. Like a section, it shrinks to a compact
    island in spotlight mode unless one of its cards is on centre stage. Part of the section HTML:
    no uniqid helper or js block. Context: the spiffysub export of format_spiffy content.

    Example context (json):
    {
        "id": 21,
        "num": 5,
        "columns": 3,
        "sectionname": "Extra practice",
        "spiffytitle": "Extra practice",
        "spiffyeyebrow": "",
        "spiffylocked": false,
        "summary": {"summarytext": ""},
        "spiffyprogress": {"done": 0, "total": 1, "percent": 0, "complete": false, "hasprogress": true, "label": "0 of 1 done"},
        "hasspiffyitems": true,
        "spiffyitems": [
            {
                "id": 7,
                "anchor": "module-7",
                "module": "page",
                "cmformat": {
                    "cmid": 7,
                    "activityname": "Read more",
                    "url": "#",
                    "spiffystep": true,
                    "spiffynote": false,
                    "spiffysub": false,
                    "spiffytracked": true,
                    "spiffyrequires": "",
                    "spiffyheadinglevel": 4,
                    "spiffystate": "available",
                    "spiffyaccent": "green",
                    "spiffytitle": "Read more",
                    "spiffybuttonlabel": "Start Read more",
                    "spiffyavailable": true
                }
            }
        ]
    }
}}
<div class="spiffy-island spiffy-island--sub{{#spiffyprogress.complete}} spiffy-island--complete{{/spiffyprogress.complete}}{{#spiffylocked}} spiffy-island--locked{{/spiffylocked}}"
    data-spiffy-island="{{id}}" data-sectionname="{{sectionname}}" role="group" aria-labelledby="spiffy-island-title-{{id}}">
    <div class="spiffy-island-head">
        {{#spiffyeyebrow}}<p class="spiffy-eyebrow">{{{spiffyeyebrow}}}</p>{{/spiffyeyebrow}}
        <h3 class="spiffy-island-title" id="spiffy-island-title-{{id}}">
            {{#spiffylocked}}{{#pix}} t/locked, core {{/pix}}{{/spiffylocked}}{{{spiffytitle}}}
        </h3>
        {{#summary.summarytext}}
            <div class="spiffy-section-summary">{{{summary.summarytext}}}</div>
        {{/summary.summarytext}}
        {{#availability}}
            <div class="spiffy-section-availability">
                {{> core_courseformat/local/content/section/availability }}
            </div>
        {{/availability}}
        {{#hasspiffyitems}}
        <div class="spiffy-island-bar">
            {{#spiffyprogress.hasprogress}}{{#spiffyprogress}}{{> format_spiffy/local/spotlight_ring }}{{/spiffyprogress}}{{/spiffyprogress.hasprogress}}
            <button type="button" class="btn mds-btn btn-primary spiffy-island-toggle" data-spiffy-toggle aria-expanded="true" aria-controls="spiffy-cards-{{id}}">
                <span class="spiffy-toggle-show">{{#str}} showactivities, format_spiffy {{/str}}</span>
                <span class="spiffy-toggle-hide">{{#str}} hideactivities, format_spiffy {{/str}}</span>
            </button>
        </div>
        {{/hasspiffyitems}}
    </div>
    {{#hasspiffyitems}}
        {{> format_spiffy/local/spotlight_cards }}
    {{/hasspiffyitems}}
</div>
