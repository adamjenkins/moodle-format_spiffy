{{!
    @template format_spiffy/local/spotlight_whatsnext

    "What's next", for the whole course: open activities due soon or overdue, then unfinished ones,
    then suggestions, so that a student notices what is there. Items for this page link to their
    card (#card-<cmid>), which spotlight mode puts on stage. The page script hides an item when its
    card here is done. Context: the whatsnext part of format_spiffy\\local\\spotlight::export_page().

    Example context (json):
    {
        "courseid": 2,
        "hasitems": true,
        "more": "",
        "total": 2,
        "main": {"items": [
            {"cmid": 3, "name": "Write your introduction", "onpage": true, "url": "#card-3", "sectionname": "Week 1",
             "datetext": "Due: Friday", "badge": {"text": "Due soon", "type": "warning"}, "overdue": false}
        ]},
        "suggestions": {"issuggestions": true, "items": [
            {"cmid": 4, "name": "Read the guide", "onpage": true, "url": "#card-4", "sectionname": "Week 1",
             "datetext": "", "badge": false, "overdue": false}
        ]}
    }
}}
<section class="spiffy-whatsnext" data-region="spiffy-whatsnext" aria-labelledby="spiffy-whatsnext-title-{{courseid}}">
    <h2 class="spiffy-whatsnext-title" id="spiffy-whatsnext-title-{{courseid}}">{{#str}} whatsnext, format_spiffy {{/str}}</h2>
    {{#main}}
        {{> format_spiffy/local/spotlight_whatsnext_list }}
    {{/main}}
    {{#more}}<p class="spiffy-whatsnext-more" data-region="spiffy-whatsnext-more">{{more}}</p>{{/more}}
    {{#suggestions}}
        <h3 class="spiffy-whatsnext-subtitle">{{#str}} whatsnextsuggest, format_spiffy {{/str}}</h3>
        {{> format_spiffy/local/spotlight_whatsnext_list }}
    {{/suggestions}}
    <p class="spiffy-whatsnext-empty" data-region="spiffy-whatsnext-empty"{{#hasitems}} hidden{{/hasitems}}>{{#str}} whatsnextnone, format_spiffy {{/str}}</p>
    {{#recent}}{{> format_spiffy/local/recent }}{{/recent}}
</section>
