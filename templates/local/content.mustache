{{!
    @template format_spiffy/local/content

    The Spiffy course page outside editing mode: "What's next" and the "Show me everything"
    toggle (format_spiffy/local/spotlight_toolbar), then each section (format_spiffy/local/section,
    pre-rendered as spiffyhtml so the page can replace it without a reload) as an island with an
    optional label, its name and summary, its progress ring, then its activities as step cards,
    text-and-media notes and subsection islands.

    The course settings switch features off: "Spotlight view" off gives the full list only
    (data-spiffy-fixedview), "Celebrate finished sections" off drops data-spiffy-celebrate.

    In spotlight mode (the default; the user preference format_spiffy_viewmode) format_spiffy/spotlight
    puts the current cards (data-spiffy-stage) on centre stage, the others in a side strip, and
    shrinks the other sections to compact islands. In list mode every card shows in its grid.

    Example context (json):
    {
        "title": "Course outline",
        "courseid": 2,
        "spiffysectionid": 0,
        "columns": 3,
        "spiffycardstyle": "soft",
        "spiffyarrows": "forwards",
        "spiffycelebrate": true,
        "sectionreturn": "null",
        "pagesectionid": "null",
        "spiffyhashes": "{}",
        "spiffyspotlight": {
            "courseid": 2,
            "viewmode": "spotlight",
            "isspotlight": true,
            "islist": false,
            "canswitch": true,
            "stage": "3",
            "whatsnext": {"courseid": 2, "hasitems": false, "total": 0, "more": "", "items": []}
        },
        "spiffysections": [
            {
                "spiffyhtml": "<section class=\"spiffy-section\" data-sectionid=\"10\"></section>",
                "id": 10,
                "num": 1,
                "sectionname": "Get ready for IVEProject",
                "spiffyeyebrow": "Before we begin",
                "spiffytitle": "Get ready for IVEProject",
                "spiffylocked": false,
                "summary": {"summarytext": "<p>Complete the activities below in order.</p>"},
                "hasspiffyitems": true,
                "spiffyitems": [
                    {
                        "id": 3,
                        "anchor": "module-3",
                        "module": "forum",
                        "cmformat": {
                            "cmid": 3,
                            "activityname": "Learn how to communicate here",
                            "url": "#",
                            "spiffystep": true,
                            "spiffynumber": 1,
                            "spiffyaccent": "green",
                            "spiffytitle": "Step 1: Learn how to communicate here",
                            "spiffybuttonlabel": "Practise in the forum",
                            "spiffyavailable": true,
                            "spiffyunlockhint": "Complete this step to unlock Step 2."
                        }
                    },
                    {
                        "id": 4,
                        "anchor": "module-4",
                        "module": "label",
                        "cmformat": {
                            "cmid": 4,
                            "spiffynote": true,
                            "spiffyfull": true,
                            "altcontent": "<h4>What happens next?</h4><p>The exchange opens when you finish.</p>"
                        }
                    }
                ]
            }
        ]
    }
}}
<div id="course-format-{{uniqid}}" class="format-spiffy spiffy-cardstyle-{{spiffycardstyle}} spiffy-view-{{#spiffyspotlight.islist}}list{{/spiffyspotlight.islist}}{{^spiffyspotlight.islist}}spotlight{{/spiffyspotlight.islist}}"
    data-courseid="{{courseid}}" data-spiffy-sectionid="{{spiffysectionid}}" data-spiffy-hashes="{{spiffyhashes}}" data-spiffy-hint-label="{{#str}} completefirst, format_spiffy {{/str}}" data-spiffy-arrows="{{spiffyarrows}}"{{#spiffycelebrate}} data-spiffy-celebrate="1"{{/spiffycelebrate}}{{^spiffyspotlight.canswitch}} data-spiffy-fixedview="1"{{/spiffyspotlight.canswitch}}
    data-spiffy-viewmode="{{#spiffyspotlight.islist}}list{{/spiffyspotlight.islist}}{{^spiffyspotlight.islist}}spotlight{{/spiffyspotlight.islist}}"
    data-spiffy-stage="{{spiffyspotlight.stage}}">
    <h2 class="visually-hidden">{{{title}}}</h2>
    {{#spiffyteacher}}{{> format_spiffy/local/teacher_spotlight }}{{/spiffyteacher}}
    {{#spiffyspotlight}}{{> format_spiffy/local/spotlight_toolbar }}{{/spiffyspotlight}}
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-region="spiffy-announce"></div>
    {{#spiffysections}}
    {{{spiffyhtml}}}
    {{/spiffysections}}
</div>
{{#js}}
require(['core_courseformat/local/content'], function(component) {
    component.init('#page', {}, {{sectionreturn}}, {{#pagesectionid}}{{.}}{{/pagesectionid}}{{^pagesectionid}}null{{/pagesectionid}});
});
require(['format_spiffy/hints'], function(hints) {
    hints.init('#course-format-{{uniqid}}');
});
require(['format_spiffy/inline'], function(inline) {
    inline.init('#course-format-{{uniqid}}');
});
require(['format_spiffy/spotlight'], function(spotlight) {
    spotlight.init('#course-format-{{uniqid}}');
});
require(['format_spiffy/tools'], function(tools) {
    tools.init('#course-format-{{uniqid}}');
});
require(['format_spiffy/teacher'], function(teacher) {
    teacher.init('#course-format-{{uniqid}}');
});
{{/js}}
