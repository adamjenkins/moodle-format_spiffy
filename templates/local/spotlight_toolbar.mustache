{{!
    @template format_spiffy/local/spotlight_toolbar

    The top of the Spiffy course page: "What's next" and the "Show me everything" toggle between
    spotlight mode and the full list (canswitch: the course setting "Spotlight view"; nothing at all
    when neither is on, hastoolbar). Context: format_spiffy\\local\\spotlight::export_page().

    Example context (json):
    {
        "courseid": 2,
        "viewmode": "spotlight",
        "isspotlight": true,
        "islist": false,
        "canswitch": true,
        "hastoolbar": true,
        "stage": "3",
        "whatsnext": {
            "courseid": 2,
            "hasitems": true,
            "total": 1,
            "more": "",
            "main": {"items": [
                {"cmid": 3, "name": "Write your introduction", "onpage": true, "url": "#card-3", "sectionname": "Week 1",
                 "datetext": "Due: Friday", "badge": {"text": "Due soon", "type": "warning"}, "overdue": false}
            ]},
            "suggestions": false
        }
    }
}}
{{#hastoolbar}}
<div class="spiffy-toolbar">
    {{#whatsnext}}{{> format_spiffy/local/spotlight_whatsnext }}{{/whatsnext}}
    {{#canswitch}}
    <div class="spiffy-viewmode">
        <button type="button" class="btn mds-btn btn-outline-secondary spiffy-viewmode-toggle" data-spiffy-viewtoggle
            aria-pressed="{{#islist}}true{{/islist}}{{^islist}}false{{/islist}}">
            {{#pix}} i/section, core {{/pix}}{{#str}} showeverything, format_spiffy {{/str}}
        </button>
    </div>
    {{/canswitch}}
</div>
{{/hastoolbar}}
