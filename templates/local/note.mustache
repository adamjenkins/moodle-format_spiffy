{{!
    @template format_spiffy/local/note

    The inside of one text-and-media note (the list item is in format_spiffy/local/spotlight_cards).
    In spotlight mode notes stay beside the cards on centre stage.

    Example context (json):
    {
        "cmid": 4,
        "altcontent": "<h4>What happens next?</h4><p>The exchange opens when you finish.</p>"
    }
}}
<div class="spiffy-note-box{{#spiffydimmed}} spiffy-dimmed{{/spiffydimmed}}">
    <div class="spiffy-badges spiffy-note-badges">
        {{#activitybadge}}{{> core_courseformat/local/content/cm/activitybadge }}{{/activitybadge}}
        {{> core_courseformat/local/content/cm/badges }}
    </div>
    {{#altcontent}}<div class="spiffy-note-content">{{{altcontent}}}</div>{{/altcontent}}
    {{#afterlink}}<div class="spiffy-cm-afterlink">{{{afterlink}}}</div>{{/afterlink}}
    {{#modavailability}}
        <div class="spiffy-cm-availability">
            {{> core_courseformat/local/content/cm/availability }}
        </div>
    {{/modavailability}}
</div>
