{{!
    @template format_spiffy/local/recent

    "Recently viewed": small links to what the user was just looking at. A link brings its card on
    stage and scrolls to it (format_spiffy/spotlight). Context: format_spiffy\local\recent::export().

    Example context (json):
    {
        "items": [
            {"cmid": 3, "name": "Plan your observing…", "fullname": "Plan your observing night",
                "url": "#card-3"},
            {"cmid": 4, "name": "Sky words", "fullname": "Sky words", "url": "#card-4"}
        ]
    }
}}
<nav class="spiffy-recent" data-region="spiffy-recent" aria-label="{{#str}} recentlyviewed, format_spiffy {{/str}}">
    <span class="spiffy-recent-label" aria-hidden="true">{{#str}} recentlyviewed, format_spiffy {{/str}}</span>
    <ul class="spiffy-recent-list list-unstyled">
        {{#items}}
        <li><a href="{{url}}" class="spiffy-recent-link" data-spiffy-focus="{{cmid}}" title="{{fullname}}" aria-label="{{fullname}}">{{name}}</a></li>
        {{/items}}
    </ul>
</nav>
